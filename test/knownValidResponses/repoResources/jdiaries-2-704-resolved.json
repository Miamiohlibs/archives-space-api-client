        {
            "jsonmodel_type": "note_multipart",
            "persistent_id": "b59a6690316199fb79730c20249c376d",
            "type": "bioghist",
            "subnotes": [
                {
                    "jsonmodel_type": "note_text",
                    "content": "In the fall of 2019, the Walter Havighurst Special Collections and University Archives collaborated with Hillel at Miami University to create a Jewish student diary project focused on recording the experiences of Miami University’s Jewish community, including students and faculty. Diarists were encouraged to provide commentary on both current events and university life. Materials in this collection were included in the \"Bearing Witness: The Holocaust and Jewish Experience at Miami University\" and \"As We See It: Jewish Voices in Uncertain Times\" exhibitions at Miami University.\n\nThe \"Bearing Witness: The Holocaust and Jewish Experience at Miami University\" and \"As We See It: Jewish Voices in Uncertain Times\" was curated by Alia Levar Wegner, Digital Collections Librarian, Walter Havighurst Special Collections in 2019. ",
                    "publish": true
                }
            ],
            "publish": true
        },
        {
            "jsonmodel_type": "note_multipart",
            "persistent_id": "5932448d8d8cab9ef1c73081d4e4eb68",
            "type": "scopecontent",
            "subnotes": [
                {
                    "jsonmodel_type": "note_text",
                    "content": "This collection contains 8 diaries written by 6 Jewish undergraduate students and 2 Jewish faculty members at Miami University in the fall of 2019. The contents provide commentary on current events and university life from the perspective of Jewish students and faculty.",
                    "publish": true
                }
            ],
            "publish": true
        },
        {
            "jsonmodel_type": "note_multipart",
